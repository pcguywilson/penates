# Copy to .env and edit. .env is git-ignored.
# Absolute path to the resume PDF the tool uploads (auto-picks newest in documents/resumes/ if unset).
RESUME_PATH=C:\path\to\your\Resume.pdf
# Optional cover letter
# COVER_LETTER_PATH=C:\path\to\your\Cover_Letter.pdf

# Local Ollama (OpenAI-compatible endpoint). No cloud key required.
OLLAMA_BASE=http://127.0.0.1:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ESSAY_MODEL=qwen2.5:7b-instruct

# Optional: let the iCIMS runner auto-advance pages (still stops before the final step)
APPLY_ICIMS_ADVANCE=1
